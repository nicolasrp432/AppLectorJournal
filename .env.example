# Supabase — required for auth, database and edge functions.
# Without these, lib/supabase.ts falls back to a no-op client (dev only).
# Copy this file to `.env` and fill in real values from your Supabase project
# (Project Settings → API). These are PUBLIC (anon) values, safe for the client.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
